  "beats": [
    {
      "id": "b001",
      "text": "Long ago, when devtas and danavs still crossed paths with men, King Shantanu of Hastinapur married a woman he knew nothing about. Not her name. Not her home.",
      "emotion": "neutral",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "move": "push-in"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "stand",
            "key": "ganga"
          }
        ],
        "props": []
      },
      "pause_after": 0.4
    },
    {
      "id": "b002",
      "text": "One day, chasing deer along the river Ganga, the king came to its bank.",
      "emotion": "neutral",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "move": "pan-right"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "stand",
            "key": "ganga"
          },
          {
            "char": "shantanu",
            "x": -0.08,
            "facing": "right",
            "variant": "plain",
            "pose": "walk",
            "expr": "neutral",
            "toX": 0.32,
            "key": "shantanu"
          }
        ],
        "props": []
      }
    },
    {
      "id": "b003",
      "text": "There, on the shore, stood a woman so radiant, it was as if the river's light had taken a body.",
      "emotion": "surprise",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.6,
          "x": 0.68,
          "y": 0.52,
          "move": "push-in"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "stand",
            "key": "ganga"
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "stand",
            "expr": "neutral",
            "key": "shantanu"
          }
        ],
        "props": []
      }
    },
    {
      "id": "b004",
      "text": "Shantanu could not look away. He stepped closer, and said,",
      "emotion": "surprise",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.6,
          "x": 0.32,
          "y": 0.52,
          "move": "push-in"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "stand",
            "key": "ganga"
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "stand",
            "expr": "surprised",
            "key": "shantanu"
          }
        ],
        "props": []
      }
    },
    {
      "id": "b005",
      "text": "Who are you? A devi? A daughter of the danavs? Or a woman of this earth? I am Shantanu of the Kuru line. Be my queen.",
      "emotion": "happy",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.6,
          "x": 0.32,
          "y": 0.52,
          "move": "push-in"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "stand",
            "key": "ganga"
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "offer",
            "expr": "smile",
            "key": "shantanu",
            "speaks": true
          }
        ],
        "props": []
      },
      "voice": "kathavachak",
      "speaker": "shantanu",
      "delivery": "a smitten king, gentle and earnest"
    },
    {
      "id": "b006",
      "text": "The woman smiled. Then she set a single condition.",
      "emotion": "neutral",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.3,
          "x": 0.5,

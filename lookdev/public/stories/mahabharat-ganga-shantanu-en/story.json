          "move": "hold"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "smile",
            "pose": "talk",
            "key": "ganga"
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "stand",
            "expr": "neutral",
            "key": "shantanu"
          }
        ],
        "props": []
      },
      "pause_after": 0.4
    },
    {
      "id": "b007",
      "text": "I will be your queen, Rajan. But whatever I do, good or bad, you will never stop me.",
      "emotion": "neutral",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.6,
          "x": 0.68,
          "y": 0.52,
          "move": "push-in"
        },
        "actors": [
          {
            "char": "ganga",
            "x": 0.68,
            "facing": "left",
            "expr": "neutral",
            "pose": "talk",
            "key": "ganga",
            "speaks": true
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "stand",
            "expr": "neutral",
            "key": "shantanu"
          }
        ],
        "props": []
      },
      "voice": "deep-female",
      "speaker": "ganga",
      "delivery": "a serene divine woman, calm and grave"
    },
    {
      "id": "b008",
      "text": "And you will never speak a harsh word to me. The day you do, I will leave you.",
      "emotion": "neutral",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {
          "zoom": 1.6,

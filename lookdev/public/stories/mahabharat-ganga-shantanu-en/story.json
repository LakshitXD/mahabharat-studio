            "x": 0.68,
            "facing": "left",
            "expr": "thinking",
            "pose": "point",
            "key": "ganga",
            "speaks": true
          },
          {
            "char": "shantanu",
            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "stand",
            "expr": "neutral",
            "key": "shantanu"
          }
        ],
        "props": []
      },
      "voice": "deep-female",
      "speaker": "ganga",
      "delivery": "a serene divine woman, quietly warning"
    },
    {
      "id": "b009",
      "text": "Shantanu was lost in love. He gave his word, without a moment's thought.",
      "emotion": "happy",
      "scene": "bank",
      "shot": {
        "env": "ganga-tat",
        "mood": "day",
        "camera": {

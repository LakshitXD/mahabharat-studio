            "x": 0.32,
            "facing": "right",
            "variant": "plain",
            "pose": "bow",
            "expr": "smile",
            "key": "shantanu"
          }
        ],
        "props": []
      }
    },
    {
      "id": "b010",
      "text": "He did not know that this promise would one day ask everything of him. And from it, by the will of Ishwar, would begin the story of Bhishma.",
      "emotion": "fear",
